#!/usr/bin/env bash
# Launch Codex with approvals and its own sandbox both off.
#
# Same reasoning as the claude wrapper beside this file: the container is the boundary, and Codex's
# Landlock/seccomp sandbox re-implements inside it a subset of what --cap-drop ALL already enforces
# -- at the cost of a workspace-write policy that blocks the Go build cache and a prompt on every
# command that leaves it.
#
# A flag, not `approval_policy`/`sandbox_mode` in ~/.codex/config.toml: config.toml sits next to
# auth.json, which sessions bind-mount from the host, and a bypass written there would apply to
# whichever Codex read that directory next -- including one on the host.
set -euo pipefail

real=/usr/local/bin/codex

if [[ ${AGENT_BYPASS:-1} != 1 ]]; then
  exec "$real" "$@"
fi

# Only the default command and the two that actually run a model accept the flag.
case ${1:-} in
"" | exec | resume) ;;
-*) ;;
*)
  exec "$real" "$@"
  ;;
esac

for arg in "$@"; do
  case $arg in
  --dangerously-bypass-approvals-and-sandbox | --yolo | -a | --ask-for-approval | --ask-for-approval=* | -s | --sandbox | --sandbox=* | --full-auto)
    exec "$real" "$@"
    ;;
  esac
done

# The flag is global, but `codex exec --flag` is the documented spelling for the subcommand, so
# insert it after the subcommand rather than before it.
case ${1:-} in
exec | resume)
  sub=$1
  shift
  exec "$real" "$sub" --dangerously-bypass-approvals-and-sandbox "$@"
  ;;
esac

exec "$real" --dangerously-bypass-approvals-and-sandbox "$@"
